    {
      "id": 1,
      "title": "VPS - Target Status",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-vps"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus-vps"},
          "editorMode": "code",
          "expr": "avg(ping_loss_ratio{job=\"ping-exporter\"}) by (name, target)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus-vps"},
          "editorMode": "code",
          "expr": "sum(ping_loss_ratio{job=\"ping-exporter\"}) by (name, target, ip, type)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 80}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Time"},
            "properties": [{"id": "custom.hidden", "value": true}]
          },
          {
            "matcher": {"id": "byName", "options": "name"},
            "properties": [
              {"id": "displayName", "value": "Name"},
              {"id": "custom.width", "value": 160}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "target"},
            "properties": [
              {"id": "displayName", "value": "Host"},
              {"id": "unit", "value": "short"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "type"},
            "properties": [
              {"id": "displayName", "value": "Type"},
              {"id": "custom.width", "value": 70}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "ip"},
            "properties": [{"id": "displayName", "value": "IP"}]
          },
          {
            "matcher": {"id": "byName", "options": "Value #A"},
            "properties": [
              {"id": "displayName", "value": "Status"},
              {"id": "custom.cellOptions", "value": {"type": "color-text"}},
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 0,
                      "to": 0.9999,
                      "result": {"text": "Online", "color": "green", "index": 0}
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {"text": "Offline", "color": "red", "index": 1}
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Value #B"},
            "properties": [
              {"id": "displayName", "value": "Loss"},
              {"id": "unit", "value": "percentunit"},
              {"id": "decimals", "value": 2},
              {"id": "custom.cellOptions", "value": {"type": "color-text"}},
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": 0},
                    {"color": "orange", "value": 0.05},
                    {"color": "red", "value": 0.2}
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      }
    },
    {
